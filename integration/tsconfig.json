{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "experimentalDecorators": true
  },
  "include": [
    "playwright.config.ts",
    "agent.playwright.config.ts",
    "e2e/**/*.ts",
    "agent/**/*.ts",
    "verification/**/*.ts"
  ]
}
